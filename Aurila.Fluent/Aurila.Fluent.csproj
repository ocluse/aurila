<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aurila.Fluent</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>0.0.1-preview1.0</Version>
    <Authors>Ocluse,Thismaker,PhyTensor</Authors>
    <PackageOutputPath>..\build</PackageOutputPath>
    <Description>A Fluent 2 appearance provider for Aurila with runtime brand theming and complete component styling.</Description>
    <RepositoryUrl>https://github.com/ocluse/aurila</RepositoryUrl>
    <Copyright>© Ocluse</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <StaticWebAssetsFingerprintOnPublish>true</StaticWebAssetsFingerprintOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aurila\Aurila.csproj" />
  </ItemGroup>

  <Target Name="BundleAssets" BeforeTargets="Build">
    <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)" />
  </Target>

</Project>
