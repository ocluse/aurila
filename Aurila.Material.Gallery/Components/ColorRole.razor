<div class="color-role @Class">
    <span></span>
    <div><strong>@Name</strong><code>@Variable</code></div>
</div>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Variable { get; set; } = string.Empty;
}
