<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Aurila.Material</RootNamespace>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>0.0.1-preview1.0</Version>
		<Authors>Ocluse,Thismaker,PhyTensor</Authors>
		<PackageOutputPath>..\build</PackageOutputPath>
		<Description>A Material 3 appearance provider for Aurila. Install it for a complete, themeable Material Design look with no styling work.</Description>
		<RepositoryUrl>https://github.com/ocluse/aurila</RepositoryUrl>
		<Copyright>© Ocluse</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<StaticWebAssetsFingerprintOnPublish>true</StaticWebAssetsFingerprintOnPublish>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Aurila.Material.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Aurila\Aurila.csproj" />
	</ItemGroup>

	<!-- Unlike Aurila, this package builds its CSS too: the stylesheet is the theme, so leaving it
	     to a locally installed editor extension would make the package unbuildable on CI. -->
	<Target Name="BundleAssets" BeforeTargets="Build">
		<Exec Command="npm run build" WorkingDirectory="$(ProjectDir)" />
	</Target>

</Project>
