<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Aurila</RootNamespace>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>0.0.1-preview5.4</Version>
		<Authors>Ocluse,Thismaker,PhyTensor</Authors>
		<PackageOutputPath>..\build</PackageOutputPath>
		<Description>A Blazor UI libray meant for a simple yet flexible UI/UX development.</Description>
		<RepositoryUrl>https://github.com/ocluse/aurila</RepositoryUrl>
		<Copyright>© Ocluse</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<StaticWebAssetsFingerprintOnPublish>true</StaticWebAssetsFingerprintOnPublish>
	</PropertyGroup>

	<ItemGroup>
		<Content Remove="compilerconfig.json" />
	</ItemGroup>

	<ItemGroup>
		<None Include="compilerconfig.json" />
	</ItemGroup>
	
	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Aurila.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.7" />
		<PackageReference Include="Ocluse.LiquidSnow.Core" Version="0.6.5-preview8.2" />
	</ItemGroup>

</Project>
