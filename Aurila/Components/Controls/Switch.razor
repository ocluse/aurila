@inherits InputBase<Switch, bool>

<div @attributes="GetAppliedAttributes()" @onclick="OnClickAsync">
    <label class="au-switch__content">
        <span class="au-switch__content__slider"></span>
    </label>
    @ChildContent
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void BuildClass(ClassBuilder builder)
    {
        builder.Add("au-switch").AddIf(Value, "au-switch--checked");
        base.BuildClass(builder);
    }

    private async Task OnClickAsync()
    {
        var newValue = !Value;
        await NotifyValueChange(newValue);
    }
}